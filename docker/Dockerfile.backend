# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.backend — WarrantyGuard AI — Backend App Image
#
# Extends the ML base image (which already has all model weights baked in).
# Only copies application code — rebuilt on every push, stays fast.
# ─────────────────────────────────────────────────────────────────────────────
ARG REGISTRY=ghcr.io
ARG REPO=karthikjayakrishnaa-hub/warrantyguard-ai
ARG BASE_TAG=latest
FROM ${REGISTRY}/${REPO}/ml-base:${BASE_TAG}

WORKDIR /app

# ── Install remaining non-ML Python dependencies ──────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    sqlalchemy \
    alembic \
    pydantic-settings \
    python-multipart \
    "python-jose[cryptography]" \
    "passlib[bcrypt]" \
    psycopg2-binary \
    supabase \
    python-dotenv \
    google-genai \
    python-dateutil \
    httpx \
    numpy

# ── Copy application source ───────────────────────────────────────────────────
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini .

# ── Create storage directory (warranty policy docs, temp OCR files) ───────────
RUN mkdir -p ./app/storage

EXPOSE 8000

# ── Startup: run DB migrations then launch server ─────────────────────────────
# alembic upgrade head is idempotent — safe to run on every container start.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
